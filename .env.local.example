# From https://sanity.io/manage after creating the project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Only needed to run the one-time import (scripts/migrate-to-sanity.mjs).
# Create at sanity.io/manage → API → Tokens, with Editor permissions.
# Never commit this.
SANITY_WRITE_TOKEN=
